generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Quiz {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime   @default(now())
  questions   Question[]
}

model Question {
  id           Int      @id @default(autoincrement())
  quizId       Int
  text         String
  options      String   // Stored as JSON string e.g. '["A", "B"]'
  correctIndex Int
  timeLimit    Int      @default(20)
  
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}
