generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  
  quizzes   Quiz[]
}

model Quiz {
  id          Int        @id @default(autoincrement())
  userId      Int?
  title       String
  description String?
  isPublic    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions   Question[]
}

model Question {
  id           Int      @id @default(autoincrement())
  quizId       Int
  text         String
  options      String   // Stored as JSON string e.g. '["A", "B"]'
  correctIndex Int
  timeLimit    Int      @default(20)
  
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}
